# ─────────────────────────────────────────────────────────────────────────────
# Shree Krishna Associate website — environment variables
# Copy to .env.local for local development. In production, set these in your
# hosting provider's dashboard (e.g. Vercel → Project → Settings → Environment Variables).
# NEVER commit real values to git.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Supabase: Project → Connect → "Transaction pooler" URI, port 6543).
# On Vercel, connecting a database under Storage sets this for you (POSTGRES_URL is also accepted).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# TLS for the database: require (verify certificate) | no-verify | disable (local only)
DATABASE_SSL=require
# Optional: PEM of your provider's CA certificate (use with DATABASE_SSL=require)
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_POOL_MAX=5

# Public address of the website, no trailing slash. Must be https:// in production.
# On Vercel you can leave it unset until you connect your own domain: the *.vercel.app address is used.
SITE_URL=https://www.your-domain.in

# 32+ random characters. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── Email (choose ONE provider) ──────────────────────────────────────────────
# resend | sendgrid | log (development only — prints instead of sending)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# SENDGRID_API_KEY=
# Sender address. Must be on a domain you have verified with the provider.
EMAIL_FROM="Shree Krishna Associate <enquiries@your-domain.in>"
# Where showing requests and enquiries are delivered (defaults to associateshreekrishna775@gmail.com)
NOTIFY_EMAIL=associateshreekrishna775@gmail.com

# Secret for the scheduled jobs (/api/cron/email-retry and /api/cron/maintenance)
CRON_SECRET=

# First admin account, created automatically by `pnpm db:setup` / the Vercel build while no staff
# account exists (never changes an existing one). You must choose a new password at first sign-in;
# remove these afterwards. Password: 12+ characters mixing three of lower/upper/numbers/symbols.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME="Your Name"

# ── Optional ─────────────────────────────────────────────────────────────────
# Cloudflare Turnstile bot protection for public forms (both keys needed)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Image hosts that Next.js may resize/optimise (comma separated). Others still display, unoptimised.
# NEXT_PUBLIC_IMAGE_HOSTS=res.cloudinary.com,*.supabase.co,lh3.googleusercontent.com

# Set to false only if your host does NOT put the visitor IP in X-Forwarded-For
# TRUST_PROXY_HEADERS=true
